# ── Salgssentral telefoni-bro – konfigurasjon (per PC) ──────────────────────
# Kopier denne fila til «.env» og fyll inn. Sett opp én gang per selger-PC.

# CRM-ens adresse (produksjons-URL).
CRM_BASE_URL=https://crm-mu-eight-76.vercel.app

# Delt hemmelighet – MÅ være lik TELEPHONY_WEBHOOK_SECRET i CRM-ens miljøvariabler.
WEBHOOK_SECRET=

# Hvem denne PC-en tilhører. Bruk enten selgerens CRM-bruker-ID (anbefalt)
# eller telefon-apparatnummeret (extension) som er satt på profilen i CRM-en.
AGENT_ID=
# EXTENSION=1042

# Bria Desktop API – lokal WebSocket. Nøyaktig URL/port finner du i
# Bria Desktop API Developer Guide / Bria-innstillingene (API må være aktivert).
BRIA_WS_URL=wss://127.0.0.1:8080
# Noen Bria-oppsett krever brukernavn/passord for API-et:
# BRIA_API_USER=
# BRIA_API_PASSWORD=

# Mappa der Bria lagrer samtaleopptak (se Bria → Preferences → Recording).
# Windows-eksempel:  C:\\Users\\<bruker>\\Documents\\Bria\\Recordings
# Mac-eksempel:      /Users/<bruker>/Documents/Bria/Recordings
RECORDINGS_DIR=

# Slett lokal opptaksfil etter vellykket opplasting? (true/false)
DELETE_AFTER_UPLOAD=false

# Loggnivå: error | info | debug
LOG_LEVEL=info
