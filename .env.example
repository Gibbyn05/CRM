# ─────────────────────────────────────────────────────────────
#  Kontrakt-utsendelse (e-post + SMS) — valgfritt, stubbet foreløpig
# ─────────────────────────────────────────────────────────────
# E-post (f.eks. Postmark, Resend, SendGrid). La stå tom for å bruke
# "dry-run"-modus som bare logger og markerer kontrakten som sendt.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=salg@dittfirma.no

# SMS (f.eks. Twilio, Sveve, LINK Mobility). La stå tom for dry-run.
SMS_PROVIDER_API_KEY=
SMS_FROM=DittFirma

# Basis-URL brukt i kontrakt-lenker (åpne/signere-sporing).
NEXT_PUBLIC_APP_URL=http://localhost:3000
