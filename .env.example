# ─────────────────────────────────────────────────────────────
#  MAL — IKKE skriv ekte nøkler her! Denne fila committes til git.
#  Kopier til .env.local (ignorert av git) og fyll inn der, eller
#  sett variablene i deploy-plattformen (Vercel).
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
#  Supabase
# ─────────────────────────────────────────────────────────────
# Finnes under Project Settings → API i Supabase-dashbordet.
NEXT_PUBLIC_SUPABASE_URL=https://din-prosjekt-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# Service role-nøkkel. KUN på server (aldri NEXT_PUBLIC_). Brukes av
# telefoni-webhook og TV-visning som må skrive/lese uten innlogget bruker.
SUPABASE_SERVICE_ROLE_KEY=din-service-role-key

# ─────────────────────────────────────────────────────────────
#  Telefoni-integrasjon (Bria / Ice softphone)
# ─────────────────────────────────────────────────────────────
# Delt hemmelighet som webhook-endepunktet krever i X-Webhook-Secret-headeren.
# Sett den samme verdien i den eksterne telefoni-kilden.
TELEPHONY_WEBHOOK_SECRET=bytt-meg-til-en-lang-tilfeldig-streng

# ─────────────────────────────────────────────────────────────
#  Claude API (AI-generert dagsavis)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modell for dagsavis-oppsummeringen. Standard er claude-opus-4-8.
# For rimeligere daglige rapporter kan claude-haiku-4-5 brukes.
ANTHROPIC_MODEL=claude-opus-4-8

# ─────────────────────────────────────────────────────────────
#  E-postutsendelse via Resend (kontrakter/tilbud)
# ─────────────────────────────────────────────────────────────
# API-nøkkel fra Resend (Dashboard → API Keys). Server-only, aldri NEXT_PUBLIC.
# La stå tom for "dry-run"-modus som bare logger og markerer som sendt.
RESEND_API_KEY=re_...
# Avsender. Domenet MÅ være verifisert i Resend (f.eks. reachr.no).
EMAIL_FROM=Salgssentral <noreply@reachr.no>

# ─────────────────────────────────────────────────────────────
#  SMS-utsendelse — valgfritt, stubbet foreløpig
# ─────────────────────────────────────────────────────────────
# SMS (f.eks. Sveve, LINK Mobility). La stå tom for dry-run.
SMS_PROVIDER_API_KEY=
SMS_FROM=DittFirma

# Basis-URL brukt i kontrakt-lenker (åpne/signere-sporing).
NEXT_PUBLIC_APP_URL=http://localhost:3000
