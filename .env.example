# ─────────────────────────────────────────────────────────────
#  MAL — IKKE skriv ekte nøkler her! Denne fila committes til git.
#  Kopier til .env.local (ignorert av git) og fyll inn der, eller
#  sett variablene i deploy-plattformen (Vercel).
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
#  Supabase
# ─────────────────────────────────────────────────────────────
# Finnes under Project Settings → API i Supabase-dashbordet.
NEXT_PUBLIC_SUPABASE_URL=https://din-prosjekt-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# Service role-nøkkel. KUN på server (aldri NEXT_PUBLIC_). Brukes av
# telefoni-webhook og TV-visning som må skrive/lese uten innlogget bruker.
SUPABASE_SERVICE_ROLE_KEY=din-service-role-key

# Hemmelig nøkkel brukt av cron-jobben som genererer dagsavisen automatisk.
# Sett samme verdi i Vercel-miljøet eller scheduler-oppsettet som treffer
# /api/dagsavis.
CRON_SECRET=byt-mig-til-en-lang-tilfeldig-streng

# ─────────────────────────────────────────────────────────────
#  Telefoni-integrasjon (Bria / Ice softphone)
# ─────────────────────────────────────────────────────────────
# Delt hemmelighet som webhook-endepunktet krever i X-Webhook-Secret-headeren.
# Sett den samme verdien i den eksterne telefoni-kilden.
TELEPHONY_WEBHOOK_SECRET=bytt-meg-til-en-lang-tilfeldig-streng

# ─────────────────────────────────────────────────────────────
#  OpenAI API (AI-generert dagsavis)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Standard er gpt-5-nano fordi dagsavis-oppsummeringen er kort,
# strukturert og kostnadssensitiv. Kan overstyres til gpt-5-mini ved behov.
OPENAI_DAGSAVIS_MODEL=gpt-5-nano
# Valgfritt: egen modell for ledelsens «Spør CRM».
OPENAI_CRM_MODEL=gpt-5-nano

# ─────────────────────────────────────────────────────────────
#  E-postutsendelse via Resend (kontrakter/tilbud/avtalepåminnelser)
# ─────────────────────────────────────────────────────────────
# API-nøkkel fra Resend (Dashboard → API Keys). Server-only, aldri NEXT_PUBLIC.
# La stå tom for "dry-run"-modus som bare logger og markerer som sendt.
RESEND_API_KEY=re_...
# Fallback-avsender hvis Innstillinger → Kommunikasjon ikke har satt et eget
# avsendernavn/-adresse ennå. Domenet MÅ være verifisert i Resend.
EMAIL_FROM=Salgssentral <noreply@reachr.no>
# Signeringshemmelighet fra Resend → Webhooks → (velg endepunkt) → Signing
# secret. Kreves for at /api/webhooks/resend skal godta hendelser.
RESEND_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────
#  SMS-utsendelse (Sveve) — konfigureres i tillegg til Innstillinger →
#  Kommunikasjon (avsendernavn, maler, påminnelsesregler bor der).
# ─────────────────────────────────────────────────────────────
# Hvilken adapter i src/lib/providers/sms.ts som skal brukes. I dag finnes
# kun "sveve". La stå tom for å bruke standardvalget.
SMS_PROVIDER=sveve
# Sveve-kontoens brukernavn/passord (sveve.no). La begge stå tomme for
# dry-run (logger, sender ikke faktisk SMS).
SVEVE_USER=
SVEVE_PASSWORD=
# Delt hemmelighet for SMS-leverandørens leveranse-webhook, HVIS de har en
# (se /api/webhooks/sms — payload-format må verifiseres mot leverandøren).
SMS_WEBHOOK_SECRET=
# Dagsavis-SMS er avskrudd til leverandør er konfigurert og ønsket brukt.
DAGSAVIS_SMS_ENABLED=false

# Basis-URL brukt i kontrakt-lenker (åpne/signere-sporing).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
#  Reachr datakilder (server-only)
# ─────────────────────────────────────────────────────────────
# Brreg brukes uten nøkkel. Disse ekstra kildene krever avtale/API-tilgang.
# Ikke legg disse inn med NEXT_PUBLIC_.
PROFF_API_TOKEN=
ENIRO_PROFILE=
ENIRO_KEY=
API1881_KEY=
